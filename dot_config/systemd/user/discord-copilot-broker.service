[Unit]
Description=Discord broker for host-native GitHub Copilot CLI sessions
Documentation=file://%h/repos/discord-copilot-broker/README.md
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=%h/.nvm/versions/node/v24.18.1/bin/copilot
ConditionPathIsDirectory=%h/repos/discord-copilot-broker

[Service]
Type=simple
WorkingDirectory=%h/repos/discord-copilot-broker
ExecStart=%h/.nvm/versions/node/v24.18.1/bin/node %h/repos/discord-copilot-broker/src/index.js
LoadCredential=discord-bot-token:%h/.config/discord-copilot-broker/discord-bot-token
Environment=DISCORD_BOT_TOKEN_FILE=%d/discord-bot-token
Environment=DISCORD_GUILD_ID=1534099914391556228
Environment=DISCORD_CHANNEL_ID=1534100366373818428
Environment=DISCORD_USER_ID=710119698313773178
Environment=DISCORD_ROLE_ID=1534099998214717453
Environment=BROKER_DEFAULT_CWD=/home/sachin
Environment=BROKER_COPILOT_ALLOW_ALL=true
Environment=BROKER_MAX_SESSIONS=3
Environment=COPILOT_BIN=/home/sachin/.nvm/versions/node/v24.18.1/bin/copilot
Environment=PATH=/home/sachin/.local/bin:/home/sachin/.nvm/versions/node/v24.18.1/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
PrivateTmp=true

[Install]
WantedBy=default.target
